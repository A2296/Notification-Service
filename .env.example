# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000

# Local MongoDB: mongodb://localhost:27017/notification_service
# Atlas:         mongodb+srv://<user>:<password>@<cluster>/notification_service
DB_CONNECTION_STRING=mongodb://localhost:27017/notification_service

# Use a long random string, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Requests per IP per 15 minutes on /api (default 100)
RATE_LIMIT_MAX=100

# Used only by `npm run seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
