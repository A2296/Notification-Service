# Copy this file to .env and fill in real values. Never commit .env.

# ---- Required ----
# Local MongoDB: mongodb://localhost:27017/notification_service
# Atlas:         mongodb+srv://<user>:<password>@<cluster>/notification_service
DB_CONNECTION_STRING=mongodb://localhost:27017/notification_service

# Long random string, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# ---- Server ----
PORT=5000
# Public URL of this API (needed for Twilio delivery callbacks), e.g. https://api.example.com
PUBLIC_BASE_URL=
# Set to 1 when running behind a proxy/load balancer (Render, Railway, Nginx)
TRUST_PROXY=
# Comma-separated browser origins allowed to call the API (default: none; integrations are server-to-server)
CORS_ORIGIN=
JWT_EXPIRES_IN=1d

# ---- Rate limits ----
# Requests per IP per minute across the whole API (applies before authentication)
IP_RATE_LIMIT_MAX=600
# Login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20
# Requests per business per minute
RATE_LIMIT_MAX=300

# ---- Delivery worker ----
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
DELIVERY_MAX_ATTEMPTS=3

# ---- Email: console (log only) or smtp ----
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- SMS: console (log only) or twilio ----
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Use instead of TWILIO_FROM_NUMBER if you have a Messaging Service
TWILIO_MESSAGING_SERVICE_SID=

# ---- Used only by `npm run seed:admin` (platform administrator) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
